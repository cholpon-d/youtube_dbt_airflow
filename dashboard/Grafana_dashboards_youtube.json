          "pluginVersion": "4.12.0",
          "queryType": "table",
          "rawSql": "SELECT \r\n    title AS \"Video Title\",\r\n    category_name AS \"Category\",\r\n    views_day_1 AS \"Views (Day 1)\",\r\n    like_percentage_day_1 AS \"Like %\",\r\n    popularity_tier_day_1 AS \"Tier\"\r\nFROM analytics.fact_video_sparks\r\nWHERE title NOT LIKE '#%'       \r\n  AND title != ''                   \r\n  AND length(title) > 5             \r\n  AND published_at >= $__fromTime \r\n  AND published_at <= $__toTime\r\nORDER BY views_day_1 DESC\r\nLIMIT 15",
          "refId": "A"
        }
      ],
      "title": "Viral Sparks: Top Performing Videos",
